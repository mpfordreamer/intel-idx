# App Environment
ENVIRONMENT=development
APP_NAME=IDX-Intel AI
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0

# LLM API Key (OpenAI / OpenRouter / Custom Compatible API)
# OPTION 1: OrcaRouter Cloud (Free Tier)
# LLM_PROVIDER=orcarouter
# LLM_MODEL=qwen/qwen3.8-27b-free
# LLM_MODEL_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_API_KEY=your_orcarouter_api_key_here

# OPTION 2: Local On-Premise Ollama (Unlimited)
LLM_PROVIDER=orcarouter
LLM_MODEL=qwen3:14b
LLM_MODEL_URL=http://YOUR_SERVER_IP:11434/v1
ORCAROUTER_API_KEY=ollama

# WAHA (WhatsApp HTTP API) Configuration
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your_waha_api_key_here
WAHA_SESSION_ID=default
WAHA_WEBHOOK_SECRET=your_webhook_secret_here
BROADCAST_CHAT_ID=your_whatsapp_group_id@g.us

# Rate Limiting & Scheduler Settings
SCRAPE_INTERVAL_MINUTES=5
RATE_LIMIT_COMMANDS_PER_MINUTE=10
